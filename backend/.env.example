# ============================================================
# TRACEID — Environment Configuration Template
# Copy this file to .env and fill in your real values.
# NEVER commit .env to Git.
# ============================================================

# --- Database ---
DATABASE_URL=postgresql+asyncpg://traceid:traceid@localhost:5432/traceid
DATABASE_URL_SYNC=postgresql://traceid:traceid@localhost:5432/traceid

# --- API Server ---
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=False
LOG_LEVEL=INFO

# --- Mode ---
DEMO_MODE=False
LIVE_ADAPTER_ENABLED=True

# --- LLM (Gemini) ---
LLM_PROVIDER=gemini
LLM_API_KEY=YOUR_GEMINI_API_KEY_HERE
LLM_MODEL=gemini-3.5-flash-lite

# --- Tavily Web Search ---
# Get a key at https://tavily.com/
TAVILY_API_KEY=YOUR_TAVILY_API_KEY_HERE

# --- SerpApi (Enhanced Web + Social Profile Search) ---
# Get a key at https://serpapi.com/
# Leave blank to disable SerpApi search (app still runs normally).
SERPAPI_API_KEY=
